# Frontend (Vite) — safe to expose in the browser bundle
VITE_CONVEX_URL=
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Convex deployment env vars — set these with `npx convex env set`, NOT here:
#   npx convex env set LIVEKIT_API_KEY APIxxxxxxxx
#   npx convex env set LIVEKIT_API_SECRET your-api-secret
#   npx convex env set LIVEKIT_HOST https://your-project.livekit.cloud
#   npx convex env set RESTREAM_RTMP_URL rtmp://a.rtmp.youtube.com/live2/your-stream-key
